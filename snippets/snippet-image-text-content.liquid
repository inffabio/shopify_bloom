{% comment %} snippet-image-text-content.liquid — extracted from image-text.liquid {% endcomment %}

{% if section.settings.heading != blank %}
  <h2 class="font-serif text-balance" style="
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    color: {{ section.settings.heading_color }};
    font-weight: 400;
    line-height: 1.2;
    margin-top: 0;
    margin-bottom: 0.75rem;
  ">{{ section.settings.heading }}</h2>
{% endif %}

{% if section.settings.subtitle != blank %}
  <p class="text-balance" style="
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    color: {{ section.settings.subtitle_color }};
    font-weight: 400;
    line-height: 1.5;
    margin-top: 0;
    margin-bottom: 1.5rem;
    max-width: 54ch;
  ">{{ section.settings.subtitle }}</p>
{% endif %}

<div class="leading-relaxed [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-atelier-mocha/40" style="
  font-size: clamp(0.9375rem, 1.25vw, 1.0625rem);
  color: {{ section.settings.body_color }};
  line-height: 1.75;
  max-width: 62ch;
  {% if section.settings.heading == blank and section.settings.subtitle == blank %}margin-top: 0;{% endif %}
">
  {{ text_block.settings.text_content }}
</div>
