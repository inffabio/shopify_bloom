{% liquid
  assign button_type_value = button_type | default: 'button'
  assign button_text_value = button_text | default: 'Button'
  assign button_variant_value = button_variant | default: 'primary'

  capture variant_classes
    case button_variant_value
      when 'secondary'
        echo 'border border-[#8B6F5C]/20 bg-white text-[#8B6F5C] hover:bg-[#8B6F5C] hover:text-white shadow-[0_16px_35px_-24px_rgba(139,111,92,0.4)]'
      when 'ghost'
        echo 'bg-transparent text-[#8B6F5C] hover:bg-[#FFF7F3]'
      else
        echo 'bg-[#80A1D4] text-white hover:bg-[#5c7bb0] shadow-[0_18px_40px_-22px_rgba(128,161,212,0.45)]'
    endcase
  endcapture
%}

<button
  type="{{ button_type_value }}"
  class="inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-60 {{ variant_classes }} {{ button_classes }}"
  {% if button_id %}id="{{ button_id }}"{% endif %}
  {% if button_name %}name="{{ button_name }}"{% endif %}
  {% if button_value %}value="{{ button_value }}"{% endif %}
  {% if button_formaction %}formaction="{{ button_formaction }}"{% endif %}
  {% if button_disabled %}disabled{% endif %}
  {{ button_attributes }}
>
  <span data-button-label>{{ button_text_value }}</span>
  <svg class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-button-spinner>
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"></path>
  </svg>
</button>
