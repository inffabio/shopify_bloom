<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="{{ 'favicon-32x32.png' | asset_url }}" type="image/png">
  <title>{{ page_title }}</title>
  {{ content_for_header }}
  {{ 'tailwind.css' | asset_url | stylesheet_tag }}
</head>
{% liquid
  assign page_bg = '#D4B8A8'
  assign page_ink = '#4D3D32'
%}
<body class="relative isolate flex min-h-screen flex-col overflow-x-hidden" style="background-color: {{ page_bg }}; color: {{ page_ink }};">
  {% section 'menu-bar' %}
  <main class="flex-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
</body>
</html>
