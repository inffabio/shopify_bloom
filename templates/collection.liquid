<main class="container mx-auto px-4 sm:px-6 py-8">
  <div class="mx-auto max-w-6xl">
    <!-- Search Bar -->
    <div class="mb-6 sm:mb-8">
      <div class="relative max-w-2xl mx-auto">
        <svg class="absolute left-3 sm:left-4 top-1/2 transform -translate-y-1/2 text-mocha-dark w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          id="search-products"
          placeholder="Search products..."
          class="w-full pl-10 sm:pl-12 pr-4 py-2 sm:py-3 rounded-full border-2 border-atelier-mocha focus:outline-none focus:ring-2 focus:ring-atelier-mocha/30 text-sm sm:text-lg"
        >
      </div>
    </div>

    {% paginate collection.products by 12 %}
    <!-- Page Title -->
    <div class="text-center mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-atelier-mocha mb-3 sm:mb-4">
        {{ collection.title }}
      </h1>

      <div class="flex items-center justify-center gap-4 text-base sm:text-lg text-mocha-dark">
        <div class="relative group">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" aria-label="Página anterior" class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-atelier-mocha text-atelier-mocha hover:bg-atelier-mocha hover:text-white transition-colors font-bold">
              &lt;
            </a>
          {% else %}
            <span aria-disabled="true" class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-atelier-mocha/40 text-atelier-mocha/40 cursor-not-allowed font-bold">
              &lt;
            </span>
          {% endif %}
          <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-atelier-mocha px-2 py-1 text-xs text-white opacity-0 group-hover:opacity-100 transition-opacity">
            Anterior
          </span>
        </div>

        <p>
          <span id="product-count">{{ collection.products_count }}</span> product{{ collection.products_count | pluralize: '', 's' }} available
          <span class="ml-2 font-semibold text-atelier-mocha">{{ paginate.current_page }}/{{ paginate.pages }}</span>
        </p>

        <div class="relative group">
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" aria-label="Próxima página" class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-atelier-mocha text-atelier-mocha hover:bg-atelier-mocha hover:text-white transition-colors font-bold">
              &gt;
            </a>
          {% else %}
            <span aria-disabled="true" class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-atelier-mocha/40 text-atelier-mocha/40 cursor-not-allowed font-bold">
              &gt;
            </span>
          {% endif %}
          <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-atelier-mocha px-2 py-1 text-xs text-white opacity-0 group-hover:opacity-100 transition-opacity">
            Próximo
          </span>
        </div>
      </div>
    </div>

      <!-- Products Grid -->
      <div class="relative mb-8 sm:mb-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {% for product in collection.products %}
            <a href="{{ product.url }}" class="group overflow-hidden bg-white border border-blush-peach/30 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col rounded-lg h-full cursor-pointer">
              <!-- Product Image -->
              <div class="aspect-square relative overflow-hidden bg-surface-light">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 300 }}"
                    alt="{{ product.title }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  >
                {% else %}
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-blush-peach" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <!-- Product Info -->
              <div class="p-3 sm:p-4 flex-1 flex flex-col">
                <h3 class="font-serif text-atelier-mocha text-base sm:text-lg mb-2 line-clamp-2">
                  {{ product.title }}
                </h3>

                {% if product.description %}
                  <p class="text-mocha-dark text-xs sm:text-sm mb-3 line-clamp-2 flex-1">
                    {{ product.description | strip_html }}
                  </p>
                {% endif %}

                <p class="text-atelier-mocha font-semibold text-lg sm:text-xl mb-3 sm:mb-4">
                  {% if product.price %}
                    {{ product.price | money }}
                  {% endif %}
                </p>
              </div>
            </a>
          {% else %}
            <div class="col-span-full text-center py-12 sm:py-16">
              <svg class="w-12 h-12 sm:w-16 sm:h-16 text-blush-peach mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m0 0L4 7m8 4v10l8-4v-10L12 11m0 0L4 7"/>
              </svg>
              <p class="text-mocha-dark text-sm sm:text-lg">
                No products found in this collection.
              </p>
            </div>
          {% endfor %}
        </div>

      </div>
    {% endpaginate %}
  </div>
</main>

<script type="module">
  import { initProductsPagination } from "{{ 'productsPagination.js' | asset_url }}";

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductsPagination);
  } else {
    initProductsPagination();
  }
</script>
