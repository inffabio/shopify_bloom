<style>
  .slideshow-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    animation: slidefade 16s infinite;
  }
  .slideshow-img:nth-child(1) { animation-delay: 0s; }
  .slideshow-img:nth-child(2) { animation-delay: 4s; }
  .slideshow-img:nth-child(3) { animation-delay: 8s; }
  .slideshow-img:nth-child(4) { animation-delay: 12s; }

  @keyframes slidefade {
    0%   { opacity: 0; }
    5%   { opacity: 1; }
    25%  { opacity: 1; }
    30%  { opacity: 0; }
    100% { opacity: 0; }
  }
</style>

<header class="relative w-full overflow-hidden bg-[#fff8f3] h-56 sm:h-72 md:h-80">
  <img src="{{ 'Image01c-opt-800.jpg' | asset_url }}" alt="Blossom Bloom banner 1" class="slideshow-img" loading="eager">
  <img src="{{ 'Image02c-opt-800.jpg' | asset_url }}" alt="Blossom Bloom banner 2" class="slideshow-img" loading="lazy">
  <img src="{{ 'Image01c-opt-800.jpg' | asset_url }}" alt="Blossom Bloom banner 3" class="slideshow-img" loading="lazy">
  <img src="{{ 'Image02c-opt-800.jpg' | asset_url }}" alt="Blossom Bloom banner 4" class="slideshow-img" loading="lazy">
</header>

