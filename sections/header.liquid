{% if section.settings.background_image_header %}
<header>
  <img
    src="{{ section.settings.background_image_header | img_url: 'master' }}"
    alt="{{ section.settings.background_image_header.alt | escape }}"
    width="{{ section.settings.background_image_header.width }}"
    height="{{ section.settings.background_image_header.height }}"
    class="w-full h-auto block"
    loading="eager"
  >
</header>
{% endif %}

{% schema %}
{
  "name": "HeaderPagina",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image_header",
      "label": "Banner Image",
      "info": "Full-width banner image that adapts to the image dimensions."
    }
  ]
}
{% endschema %}
