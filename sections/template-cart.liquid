{% assign continue_shopping_url = routes.all_products_collection_url | default: routes.root_url %}

<section class="relative isolate overflow-x-hidden">
    <img
        src="{{ 'bgBlossom.png' | asset_url }}"
        alt=""
        class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-95"
    >
    <div class="absolute inset-0 bg-white/8"></div>

    <div class="relative mx-auto max-w-7xl px-4 pb-10 pt-28 sm:px-6 sm:pt-32 lg:px-8 lg:pt-36" data-cart-root data-money-format="{{ shop.money_format | escape }}">
        {% if cart.item_count > 0 %}
            <div class="mb-8 flex flex-col gap-4 border-b border-[#8B6F5C]/10 pb-6 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#B79A8D]">Shopping bag</p>
                    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[#8B6F5C] sm:text-4xl">Your cart</h1>
                    <p class="mt-3 text-sm text-[#8B6F5C]/70" data-cart-item-count>
                        {{ cart.item_count }} item{{ cart.item_count | pluralize: '', 's' }} selected
                    </p>
                </div>

                <a
                    href="{{ continue_shopping_url }}"
                    class="inline-flex w-full items-center justify-center rounded-full border border-[#8B6F5C]/20 bg-white/80 px-6 py-3 text-sm font-semibold text-[#8B6F5C] transition hover:border-[#8B6F5C]/40 hover:bg-white md:w-auto"
                >
                    Return to shop
                </a>
            </div>

            <form action="{{ routes.cart_url }}" method="post" novalidate class="grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(320px,0.9fr)]" data-cart-form>
                <div class="space-y-4">
                    {% for item in cart.items %}
                        {% capture remove_button_attributes %}data-cart-remove data-line="{{ forloop.index }}" data-key="{{ item.key }}"{% endcapture %}
                        <article
                            class="rounded-4xl border border-[#8B6F5C]/10 bg-white/90 p-4 shadow-[0_30px_80px_-36px_rgba(139,111,92,0.5)] backdrop-blur sm:p-6"
                            data-cart-item
                            data-key="{{ item.key }}"
                            data-unit-price="{{ item.final_price }}"
                        >
                            <div class="flex flex-col gap-5 sm:flex-row">
                                <a href="{{ item.url }}" class="block h-24 w-24 shrink-0 overflow-hidden rounded-2xl bg-[#FFF7F3] sm:h-auto sm:w-36 sm:rounded-3xl">
                                    {% if item.image %}
                                        <img
                                            src="{{ item.image | image_url: width: 320 }}"
                                            alt="{{ item.title | escape }}"
                                            class="h-24 w-24 object-cover sm:h-full sm:w-full"
                                        >
                                    {% else %}
                                        {{ 'product-1' | placeholder_svg_tag: 'h-24 w-24 sm:h-full sm:w-full' }}
                                    {% endif %}
                                </a>

                                <div class="flex min-w-0 flex-1 flex-col justify-between gap-5">
                                    <div class="space-y-3">
                                        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                                            <div>
                                                <a href="{{ item.url }}" class="text-xl font-semibold tracking-tight text-[#8B6F5C] transition hover:text-[#6F5848]">
                                                    {{ item.product.title }}
                                                </a>
                                                {% if item.variant.title != 'Default Title' %}
                                                    <p class="mt-1 text-sm text-[#8B6F5C]/60">{{ item.variant.title }}</p>
                                                {% endif %}
                                            </div>

                                            <div class="text-left md:text-right">
                                                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#B79A8D]">Value</p>
                                                <p class="mt-2 text-lg font-semibold text-[#8B6F5C]" data-cart-unit-price>{{ item.final_price | money }}</p>
                                            </div>
                                        </div>

                                        <div class="flex flex-wrap items-center gap-3 text-sm text-[#8B6F5C]/65">
                                            <span class="rounded-full bg-[#FFF7F3] px-3 py-1">Minimum 1 unit</span>
                                            <span>Subtotal: <strong class="font-semibold text-[#8B6F5C]" data-cart-line-total>{{ item.final_line_price | money }}</strong></span>
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-4 border-t border-[#8B6F5C]/10 pt-4 sm:flex-row sm:items-center sm:justify-between">
                                        <div class="inline-flex w-fit items-center rounded-full border border-[#8B6F5C]/15 bg-[#FFFDFB] p-1 shadow-sm">
                                            <button
                                                type="button"
                                                class="flex h-10 w-10 items-center justify-center rounded-full text-lg font-semibold text-[#8B6F5C] transition hover:bg-[#F6E7DF] disabled:cursor-not-allowed disabled:opacity-40"
                                                data-cart-quantity-trigger="decrease"
                                                {% if item.quantity <= 1 %}disabled{% endif %}
                                                aria-label="Decrease quantity"
                                            >
                                                -
                                            </button>

                                            <input
                                                type="number"
                                                name="updates[]"
                                                min="1"
                                                value="{{ item.quantity }}"
                                                class="h-10 w-16 border-0 bg-transparent text-center text-base font-semibold text-[#8B6F5C] outline-none"
                                                data-cart-quantity-input
                                                inputmode="numeric"
                                            >

                                            <button
                                                type="button"
                                                class="flex h-10 w-10 items-center justify-center rounded-full text-lg font-semibold text-[#8B6F5C] transition hover:bg-[#F6E7DF]"
                                                data-cart-quantity-trigger="increase"
                                                aria-label="Increase quantity"
                                            >
                                                +
                                            </button>
                                        </div>

                                        <div class="flex items-center gap-4">
                                            <div class="text-right">
                                                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#B79A8D]">Total</p>
                                                <p class="mt-1 text-lg font-semibold text-[#8B6F5C]" data-cart-line-total>{{ item.final_line_price | money }}</p>
                                            </div>

                                            {% render 'loading-button', button_type: 'button', button_text: 'Remove', button_variant: 'ghost', button_classes: 'px-0 py-0 text-sm text-[#C27D7D] hover:bg-transparent hover:text-[#A55E5E] shadow-none', button_attributes: remove_button_attributes %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <aside class="lg:sticky lg:top-10 lg:self-start">
                    <div class="overflow-hidden rounded-4xl border border-[#8B6F5C]/10 bg-white/92 p-6 shadow-[0_30px_90px_-42px_rgba(139,111,92,0.55)] backdrop-blur sm:p-8">
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#B79A8D]">Order summary</p>
                        <h2 class="mt-2 text-2xl font-semibold text-[#8B6F5C]">Ready to finish your buy?</h2>
                        <p class="mt-3 text-sm leading-6 text-[#8B6F5C]/70">Review each product, confirm the quantities and continue to checkout when everything looks right.</p>

                        <div class="mt-8 space-y-4 rounded-3xl bg-[#FFF9F6] p-5">
                            <div class="flex items-center justify-between text-sm text-[#8B6F5C]/75">
                                <span>Subtotal</span>
                                <span class="font-semibold text-[#8B6F5C]" data-cart-subtotal>{{ cart.total_price | money }}</span>
                            </div>
                            <div class="flex items-center justify-between text-sm text-[#8B6F5C]/75">
                                <span>Total</span>
                                <span class="text-xl font-semibold text-[#8B6F5C]" data-cart-total>{{ cart.total_price | money }}</span>
                            </div>
                        </div>

                        <p class="mt-4 hidden rounded-2xl border px-4 py-3 text-sm" data-cart-feedback></p>

                        <div class="mt-6 space-y-3">
                            {% render 'loading-button', button_type: 'button', button_text: 'Finish buy', button_variant: 'primary', button_classes: 'w-full', button_attributes: 'data-cart-open-checkout' %}
                        </div>

                        <a
                            href="{{ continue_shopping_url }}"
                            class="mt-4 inline-flex w-full items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-[#8B6F5C] transition hover:bg-[#FFF7F3]"
                        >
                            Return to shop
                        </a>
                    </div>
                </aside>
            </form>
        {% else %}
            <div class="mx-auto max-w-3xl rounded-5xl border border-[#8B6F5C]/10 bg-white/90 px-6 py-14 text-center shadow-[0_30px_90px_-42px_rgba(139,111,92,0.5)] backdrop-blur sm:px-10">
                <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#B79A8D]">Shopping bag</p>
                <h1 class="mt-3 text-3xl font-semibold tracking-tight text-[#8B6F5C] sm:text-4xl">Your cart is empty</h1>
                <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-[#8B6F5C]/70 sm:text-base">Start with one of your custom products and come back here to review quantities, prices and totals in a cleaner checkout flow.</p>
                <a
                    href="{{ continue_shopping_url }}"
                    class="mt-8 inline-flex items-center justify-center rounded-full bg-[#8B6F5C] px-8 py-3 text-sm font-semibold text-white shadow-[0_18px_40px_-20px_rgba(139,111,92,0.6)] transition hover:bg-[#735b4b]"
                >
                    Return to shop
                </a>
            </div>
        {% endif %}
    </div>

    <div class="pointer-events-none fixed inset-0 z-40 hidden bg-black/35 opacity-0 transition-opacity duration-300" data-cart-checkout-overlay></div>

    <aside
        class="pointer-events-none fixed right-0 top-0 z-50 hidden h-full w-[92vw] max-w-md translate-x-full overflow-y-auto border-l border-[#8B6F5C]/15 bg-white shadow-[0_24px_90px_-24px_rgba(0,0,0,0.5)] transition-transform duration-300 ease-out"
        data-cart-checkout-drawer
    >
        <div class="border-b border-[#8B6F5C]/10 bg-linear-to-r from-[#FFF8F3] to-[#FFEDEC] px-5 py-5">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#B79A8D]">Checkout</p>
                    <h3 class="mt-1 text-xl font-semibold text-[#8B6F5C]">Review and finish buy</h3>
                </div>
                <button
                    type="button"
                    class="rounded-full p-2 text-[#8B6F5C] transition hover:bg-white/70"
                    data-cart-close-checkout
                    aria-label="Close checkout panel"
                >
                    {% render 'icon-close' %}
                </button>
            </div>
        </div>

        <div class="space-y-6 px-5 py-6">
            <div class="rounded-3xl bg-[#FFF9F6] p-5">
                <div class="flex items-center justify-between text-sm text-[#8B6F5C]/75">
                    <span>Subtotal</span>
                    <span class="font-semibold text-[#8B6F5C]" data-cart-subtotal>{{ cart.total_price | money }}</span>
                </div>
                <div class="mt-3 flex items-center justify-between text-sm text-[#8B6F5C]/75">
                    <span>Total</span>
                    <span class="text-xl font-semibold text-[#8B6F5C]" data-cart-total>{{ cart.total_price | money }}</span>
                </div>
            </div>

            <p class="text-sm leading-6 text-[#8B6F5C]/70">
                Shopify checkout is secure and opens in the official checkout flow. Click below to complete your payment.
            </p>

            <a
                href="/checkout"
                class="inline-flex w-full items-center justify-center rounded-full bg-[#cb6264] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#b55759]"
            >
                Continue to secure checkout
            </a>

            <button
                type="button"
                class="inline-flex w-full items-center justify-center rounded-full border border-[#8B6F5C]/20 bg-white px-6 py-3 text-sm font-semibold text-[#8B6F5C] transition hover:bg-[#FFF7F3]"
                data-cart-close-checkout
            >
                Keep shopping
            </button>
        </div>
    </aside>
</section>

<script src="{{ 'template-cart.js' | asset_url }}" defer="defer"></script>