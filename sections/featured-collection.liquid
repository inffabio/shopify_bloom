{% schema %}
{
    "name": "Featured Collection",
    "settings": [
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
        },
        {
            "type": "range",
            "id": "products_to_show",
            "min": 1,
            "max": 12,
            "step": 1,
            "unit": "prs",
            "label": "Products to show",
            "default": 4
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Featured Collection"
        }
    ],
    "presets": [
        {
            "name": "Featured Collection",
            "category": "General"
        }
    ]
}
{% endschema %}

<h2 class="text-2xl font-serif font-semibold text-gray-900 text-center mb-6">{{ section.settings.heading }}</h2>
<div class="px-16 py-16">
    
    {% if section.settings.collection != blank %}
        
        <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6 mt-6">
            {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
                <div>
                    <a href="{{ product.url }}" class="no-underline block">
                        {% if product.featured_image %}
                            <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.featured_image.alt }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" class="w-full aspect-square object-cover">
                        {% endif %}
                        <h3 class="mt-2 text-base font-medium text-gray-900">{{ product.title }}</h3>
                        <p class="text-sm text-gray-600">{{ product.price | money }}</p>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>