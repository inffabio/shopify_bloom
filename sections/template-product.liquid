<section class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
            <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.title }}"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                class="h-full w-full object-cover"
            >
        </div>

        <div class="flex flex-col justify-center">
            <h1 class="text-3xl font-bold tracking-tight text-[#cb6264] sm:text-4xl">{{ product.title }}</h1>
            <p class="mt-4 text-2xl font-semibold text-[#cb6264]">{{ product.selected_or_first_available_variant.price | money }}</p>

            <div class="prose prose-zinc mt-6 max-w-none text-zinc-600 prose-p:text-xl prose-p:leading-relaxed">
                {{ product.description }}
            </div>

           
            <form action={{ routes.cart_add_url }} method="post" enctype="multipart/form-data" id="AddToCartForm" class="mt-8 space-y-4">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                    type="submit"
                    name="add"
                    class="inline-flex items-center justify-center rounded-lg bg-[#cb6264] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#b55759] disabled:cursor-not-allowed disabled:bg-zinc-300"     
                >
                    {% if product.available %}
                        Add to cart
                    {% else %}
                        Sold out
                    {% endif %}
                </button>
            </form>
        </div>
    </div>
</section>