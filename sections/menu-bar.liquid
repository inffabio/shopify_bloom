<div class="relative z-50 overflow-visible border-b border-white/40 shadow-[0_16px_34px_-20px_rgba(0,0,0,0.35)]" x-data="{ mobileMenuOpen: false }">
    <div
        class="pointer-events-none absolute inset-0 bg-center bg-cover"
        style="background-image: url({{ 'bgBlossom.png' | asset_url }});"
        aria-hidden="true"
    ></div>

    <div class="relative z-10">
    <div class="mx-auto px-4 sm:px-6">
        <div class="flex justify-between items-center py-1 md:justify-start md:space-x-10">
            <!-- STORE NAME / STORE LOGO -->
            <div class="flex justify-start lg:flex-1 truncate">
                {% if section.settings.Logo %}
                    <img src="{{ section.settings.Logo | image_url: width: 200 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.Logo.width }}" height="{{ section.settings.Logo.height }}">
                    {% else %}
                       <img src="{{ 'logoblossom.png' | asset_url }}" alt="{{ shop.name | escape }}" width="192" height="64" class="w-48 h-16 ">
                {% endif %}
            </div>

            <div class="-mr-2 -my-2 ml-3 flex items-center gap-1 md:hidden">
                <div class="relative" data-mini-cart-root data-money-format="{{ shop.money_format | escape }}">
                    <button
                        type="button"
                        class="relative inline-flex items-center justify-center rounded-full p-2 text-atelier-mocha transition hover:bg-white/60"
                        data-mini-cart-toggle
                        aria-expanded="false"
                        aria-controls="mini-cart-drawer"
                    >
                        {% render 'icon-shopping-bag' %}
                        {% if cart.items.size > 0 %}
                        <span
                            class="absolute -right-1 -top-1 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-semibold leading-none text-white"
                            style="background-color: var(--color-forest-accent);"
                            data-mini-cart-count
                        >
                            {{ cart.items | size }}
                        </span>
                        {% endif %}
                    </button>

                    <div class="pointer-events-none fixed inset-0 z-40 hidden bg-black/35 opacity-0 transition-opacity duration-300" data-mini-cart-overlay></div>

                    <aside
                        id="mini-cart-drawer"
                        class="pointer-events-none fixed right-0 top-0 z-50 hidden h-full w-[86vw] max-w-sm translate-x-full overflow-hidden border-l border-atelier-mocha/15 bg-white shadow-[0_20px_80px_-20px_rgba(0,0,0,0.45)] transition-transform duration-300 ease-out"
                        data-mini-cart-panel
                    >
                        <div class="flex items-center justify-between border-b border-atelier-mocha/10 bg-linear-to-r from-[#FFF8F3] to-[#FFEDEC] px-4 py-4">
                            <div>
                                <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-mocha-dark">Mini cart</p>
                                <h3 class="mt-1 text-base font-semibold text-atelier-mocha">Your selected products</h3>
                            </div>
                            <button type="button" class="rounded-full p-2 text-atelier-mocha hover:bg-white/60" data-mini-cart-close aria-label="Close mini cart">
                                {% render 'icon-close' %}
                            </button>
                        </div>

                        <div class="h-[calc(100%-15rem)] overflow-y-auto px-4 py-4" data-mini-cart-items>
                            <p class="text-sm text-mocha-dark">Loading cart...</p>
                        </div>

                        <div class="space-y-4 border-t border-atelier-mocha/10 bg-[#FFFBF9] px-4 py-4">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-mocha-dark">Subtotal</span>
                                <span class="font-semibold text-atelier-mocha" data-mini-cart-subtotal>{{ cart.total_price | money }}</span>
                            </div>

                            <div class="grid gap-2">
                                <a
                                    href="{{ routes.cart_url }}"
                                    class="inline-flex w-full items-center justify-center rounded-full border border-atelier-mocha/20 bg-white px-4 py-2 text-sm font-semibold text-atelier-mocha transition hover:bg-[#FDF6F1]"
                                >
                                    View cart
                                </a>
                                <a
                                    href="/checkout"
                                    class="inline-flex w-full items-center justify-center rounded-full bg-rose-coral px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-coral-hover"
                                >
                                    Checkout
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>

                <!-- Hamburger Menu (Mobile Only) -->
                <button x-on:click="mobileMenuOpen = true" type="button"
                    aria-label="Open menu"
                    x-bind:aria-expanded="mobileMenuOpen"
                    class="p-2 inline-flex items-center justify-center rounded-full text-atelier-mocha transition hover:bg-white/60">
                    {% render 'icon-hamburguer-menu' %}
                </button>
            </div>



            <!-- NAVIGATION MENU -->
            <nav class="relative z-50 hidden md:flex space-x-10">
                {% for link in linklists.main-menu.links %}
                {% if link.links != blank %}
                <div x-data="{ open: false }" class="relative">

                    <button x-on:click="open = !open" type="button"
                        class="font-menu-urban inline-flex items-center text-[0.95rem] text-atelier-mocha hover:text-mocha-hover transition-colors no-underline font-semibold tracking-[0.08em] whitespace-nowrap uppercase">
                        {{ link.title }}
                        {% render 'icon-dropdown' %}
                    </button>

                    <div x-show="open" x-cloak x-on:click.outside="open = false"
                        class="absolute z-60 mt-4 min-w-60 max-w-88 md:left-0 xl:left-auto xl:right-0"
                        x-transition:enter="transition ease-out duration-150"
                        x-transition:enter-start="opacity-0 -translate-y-1"
                        x-transition:enter-end="opacity-100 translate-y-0"
                        x-transition:leave="transition ease-in duration-100"
                        x-transition:leave-start="opacity-100 translate-y-0"
                        x-transition:leave-end="opacity-0 -translate-y-1"
                    >
                        <div class="relative overflow-hidden rounded-2xl shadow-[0_24px_60px_-30px_rgba(139,111,92,0.55)]">
                            <!-- Background image layer -->
                            <div
                                class="pointer-events-none absolute inset-0 bg-center bg-cover"
                                style="background-image: url({{ 'bgBlossom.png' | asset_url }});"
                                aria-hidden="true"
                            ></div>
                            <!-- Content layer -->
                            <div class="relative z-10 grid gap-3 px-4 py-4">
                                {% for childLink in link.links %}
                                    <!-- CREATE THE SUBLINK -->
                                    <a href="{{ childLink.url }}" class="font-menu-urban rounded-xl px-3 py-2 text-atelier-mocha hover:bg-[#FFF7F3] hover:text-mocha-hover transition-colors no-underline font-semibold text-[0.82rem] tracking-[0.08em] uppercase">
                                        <div>
                                            <p class="text-base font-medium">
                                                {{ childLink.title }}
                                            </p>
                                        </div>
                                    </a> 
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                {% else %}
                <div class="relative">
                    <a href="{{ link.url }}" class="font-menu-urban text-[0.95rem] text-atelier-mocha hover:text-mocha-hover transition-colors no-underline font-semibold tracking-[0.08em] whitespace-nowrap uppercase">
                        {{ link.title }}
                    </a>
                </div>

                {% endif %}
                {% endfor %}
            </nav>

            <div class="hidden md:flex items-center justify-end md:flex-1 space-x-5" data-mini-cart-root data-money-format="{{ shop.money_format | escape }}">
                <div class="relative">
                    <button
                        type="button"
                        class="relative inline-flex items-center justify-center text-atelier-mocha transition-colors hover:text-mocha-hover"
                        data-mini-cart-toggle
                        aria-expanded="false"
                        aria-controls="mini-cart-panel"
                    >
                        {% render 'icon-shopping-bag' %}
                        {% if cart.items.size > 0 %}
                        <span
                            class="absolute -right-2 -top-2 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full px-1 text-[11px] font-semibold leading-none text-white"
                            style="background-color: var(--color-forest-accent);"
                            data-mini-cart-count
                        >
                            {{ cart.items | size }}
                        </span>
                        {% endif %}
                    </button>

                    <div
                        id="mini-cart-panel"
                        class="pointer-events-none absolute right-0 z-30 mt-4 hidden w-[24rem] overflow-hidden rounded-3xl border border-atelier-mocha/15 bg-white shadow-[0_28px_80px_-40px_rgba(139,111,92,0.6)]"
                        data-mini-cart-panel
                    >
                        <div class="bg-linear-to-r from-[#FFF8F3] to-[#FFEDEC] px-5 py-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-mocha-dark">Mini cart</p>
                            <h3 class="mt-1 text-lg font-semibold text-atelier-mocha">Your selected products</h3>
                        </div>

                        <div class="max-h-80 overflow-y-auto px-5 py-4" data-mini-cart-items>
                            <p class="text-sm text-mocha-dark">Loading cart...</p>
                        </div>

                        <div class="space-y-4 border-t border-atelier-mocha/10 bg-[#FFFBF9] px-5 py-4">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-mocha-dark">Subtotal</span>
                                <span class="font-semibold text-atelier-mocha" data-mini-cart-subtotal>{{ cart.total_price | money }}</span>
                            </div>

                            <div class="grid gap-2">
                                <a
                                    href="{{ routes.cart_url }}"
                                    class="inline-flex w-full items-center justify-center rounded-full border border-atelier-mocha/20 bg-white px-4 py-2 text-sm font-semibold text-atelier-mocha transition hover:bg-[#FDF6F1]"
                                >
                                    View cart
                                </a>
                                <a
                                    href="/checkout"
                                    class="inline-flex w-full items-center justify-center rounded-full bg-rose-coral px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-coral-hover"
                                >
                                    Checkout
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- MOBILE MENU CONTAINER -->
    <div x-show="mobileMenuOpen" x-cloak class="absolute z-10 top-0 inset-x-0 p-2 transform origin-top-left md:hidden">
        <div class="shadow-lg rounded-lg ring-1 ring-black ring-opacity-5 bg-white w-full">
            <div class="p-5 divide-y-2 divide-gray-50">

                <!-- MOBILE MENU HEADER TITLE PLUS CLOSE BUTTON -->
                <div class="flex items-center justify-between pb-3">
                    <div>
                        <h1 class="text-lg text-atelier-mocha">{{ shop.name }}</h1>
                    </div>
                    <div class="-mr-2">
                        <button x-on:click="mobileMenuOpen = false" type="button"
                            class="bg-white rounded-md  text-atelier-mocha  font-bold">
                            {% render 'icon-close' %}
                        </button>
                    </div>
                </div>

                <!-- NAVIGATION LINKS FOR MOBILE MENU -->
                <div class="pt-3">
                    <nav class="grid gap-y-7">
                        {% for link in linklists.main-menu.links %}
                            {% assign link_handle = link.handle | replace: '-', '_' %}
                        {% if link.links != blank %}
                            <div x-data="{ {{link_handle}}: false }" class="relative">
                                <button x-on:click="{{link_handle}} = !{{link_handle}}" type="button"
                                    class="font-menu-urban text-[0.95rem] text-atelier-mocha hover:text-mocha-hover transition-colors no-underline font-semibold tracking-[0.08em] whitespace-nowrap uppercase flex items-center justify-between w-full">
                                    <div>{{ link.title }}</div>
                                    {% render 'icon-dropdown' %}
                                </button>

                                <div x-show="{{link_handle}}" x-cloak class="grid gap-y-7 py-3">
                                    {% for childlink in link.links %}
                                        <a href="{{ childlink.url }}" class="font-menu-urban p-3 hover:bg-gray-200 transition-colors no-underline font-semibold tracking-[0.08em] whitespace-nowrap uppercase">
                                            <span class="ml-3  text-base font-medium text-atelier-mocha">{{ childlink.title }}</span>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                        <a href="{{ link.url }}"
                            class="font-menu-urban -m-3 p-3 flex items-center rounded-md text-atelier-mocha hover:text-mocha-hover hover:bg-gray-200 transition-colors no-underline font-semibold tracking-[0.08em] whitespace-nowrap uppercase">
                            {{ link.title }}
                        </a>
                        {% endif %}
                        {% endfor %}
                    </nav>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<script defer src="{{ 'alpinejs-3.14.9.min.js' | asset_url }}"></script>
<script defer src="{{ 'jquery-4.0.0.min.js' | asset_url }}"></script>
<script src="{{ 'mini-cart.js' | asset_url }}" defer="defer"></script>

{% schema  %} 
{
    "name": "Menu Bar",
    "settings": [
        {
        "type": "image_picker",
        "id": "Logo",
        "label": "Menu Bar Logo"
        }
    ]
}
{% endschema %}