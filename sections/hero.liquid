<section class="hero-section-{{ section.id }} relative z-10 px-4 py-10 sm:px-6 sm:py-12">
        <div class="hero-border container mx-auto max-w-4xl text-center flex flex-col items-center border-t border-b py-10 sm:py-14">
                <h2 class="hero-heading mb-4 font-serif text-balance sm:mb-6">
            {{ section.settings.heading }}
        </h2>
                <p class="hero-description mb-6 max-w-2xl mx-auto leading-relaxed px-4 sm:mb-8">
            {{ section.settings.description }}
        </p>
        <a href="{{ section.settings.button_link }}" class="inline-flex rounded-full bg-wine hover:bg-wine-hover text-white px-10 py-3.5 text-lg font-medium shadow-xl transition-all duration-300 hover:-translate-y-px">
            {{ section.settings.button_text }}
        </a>
    </div>
</section>

{% stylesheet %}
    .hero-section-{{ section.id }} .hero-border {
        border-top-width: {{ section.settings.border_thickness }}px;
        border-bottom-width: {{ section.settings.border_thickness }}px;
        border-top-color: color-mix(in srgb, {{ section.settings.border_color }} {{ section.settings.border_opacity }}%, transparent);
        border-bottom-color: color-mix(in srgb, {{ section.settings.border_color }} {{ section.settings.border_opacity }}%, transparent);
    }

    .hero-section-{{ section.id }} .hero-heading {
        color: {{ section.settings.heading_color }};
        font-size: {{ section.settings.heading_size_mobile }}px;
        line-height: 1.1;
    }

    .hero-section-{{ section.id }} .hero-description {
        color: {{ section.settings.body_color }};
        font-size: {{ section.settings.body_size_mobile }}px;
    }

    @media screen and (min-width: 640px) {
        .hero-section-{{ section.id }} .hero-heading {
            font-size: {{ section.settings.heading_size_desktop }}px;
        }

        .hero-section-{{ section.id }} .hero-description {
            font-size: {{ section.settings.body_size_desktop }}px;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Hero Section",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Hero title",
            "default": "Custom Mugs & Personalized Drinkware"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Title color",
            "default": "#5F5149"
        },
        {
            "type": "range",
            "id": "heading_size_mobile",
            "min": 24,
            "max": 52,
            "step": 2,
            "unit": "px",
            "label": "Title size mobile",
            "default": 32
        },
        {
            "type": "range",
            "id": "heading_size_desktop",
            "min": 32,
            "max": 80,
            "step": 2,
            "unit": "px",
            "label": "Title size desktop",
            "default": 48
        },
        {
            "type": "range",
            "id": "border_thickness",
            "min": 1,
            "max": 5,
            "step": 1,
            "unit": "px",
            "label": "Border thickness",
            "default": 3
        },
        {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "default": "#8B6F5C"
        },
        {
            "type": "range",
            "id": "border_opacity",
            "min": 5,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Border opacity",
            "default": 15
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Body text",
            "default": "Transform your daily moments with beautifully personalized mugs and tumblers. From custom designs to elegant sets, we create drinkware that reflects your unique style and brings joy to every sip."
        },
        {
            "type": "color",
            "id": "body_color",
            "label": "Body text color",
            "default": "#4D3D32"
        },
        {
            "type": "range",
            "id": "body_size_mobile",
            "min": 14,
            "max": 28,
            "step": 1,
            "unit": "px",
            "label": "Body text size mobile",
            "default": 16
        },
        {
            "type": "range",
            "id": "body_size_desktop",
            "min": 16,
            "max": 36,
            "step": 1,
            "unit": "px",
            "label": "Body text size desktop",
            "default": 18
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Shop Now"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link",
            "default": "/collections/all"
        }
    ],
    "presets": [
        {
            "name": "Hero Section",
            "category": "General"
        }
    ]
}
{% endschema %}
      