<section class="relative z-10 px-4 py-6 sm:px-6 sm:py-8">
  <link href="https://fonts.googleapis.com/css2?family=Lilita+One&display=swap" rel="stylesheet">
  <div class="w-full">
    <div class="relative rounded-xl bg-white p-4 shadow-[0_18px_40px_-24px_rgba(95,81,73,0.35)]" data-bloom-carousel>
      <div class="rounded-lg" style="position: relative; overflow: visible;">
        <div class="relative overflow-hidden rounded-lg">
          <div class="relative z-0 flex" style="transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);" data-bloom-track>
          {% assign slide_number = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'slide' %}
              {% assign slide_number = slide_number | plus: 1 %}
              <div class="w-full shrink-0 relative" data-bloom-slide {{ block.shopify_attributes }}>
                {% render 'snippet-carousel-slide-image', block: block, is_first: forloop.first %}

                <!-- Text Overlays específicos deste slide -->
                {% for text_block in section.blocks %}
                  {% if text_block.type == 'text_overlay' and text_block.settings.overlay_text != blank and text_block.settings.target_slide == slide_number %}
                    {% render 'snippet-text-overlay', text_block: text_block %}
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% render 'snippet-carousel-dots', blocks: section.blocks %}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "📸 Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback asset filename (if no image selected)",
          "info": "Enter the exact filename from your theme assets, e.g. Image01c-opt-800.jpg"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Carousel slide"
        }
      ]
    },
    {
      "type": "text_overlay",
      "name": "📝 Text Overlay",
      "settings": [
            {
              "type": "text",
              "id": "overlay_text",
              "label": "Text content",
              "placeholder": "Enter your text here"
            },
            {
              "type": "range",
              "id": "target_slide",
              "label": "Target slide number",
              "min": 1,
              "max": 20,
              "step": 1,
              "default": 1,
              "info": "Which slide number to display this overlay on (1 = first slide)"
            },
            {
              "type": "select",
              "id": "text_position",
              "label": "Horizontal position",
              "options": [
                {
                  "value": "left",
                  "label": "Left"
                },
                {
                  "value": "middle",
                  "label": "Middle"
                },
                {
                  "value": "right",
                  "label": "Right"
                }
              ],
              "default": "middle"
            },
            {
              "type": "range",
              "id": "vertical_position",
              "label": "Distance from top",
              "min": 0,
              "max": 400,
              "step": 10,
              "unit": "px",
              "default": 50,
              "info": "0px = top of image, increase to move text down"
            },
            {
              "type": "range",
              "id": "margin",
              "label": "Margin left/right",
              "min": 0,
              "max": 100,
              "step": 5,
              "unit": "px",
              "default": 20,
              "info": "Space from left or right edge"
            },
            {
              "type": "range",
              "id": "margin_left",
              "label": "Margin left (text)",
              "min": 0,
              "max": 100,
              "step": 5,
              "unit": "px",
              "default": 0,
              "info": "Additional left margin on the text container"
            },
            {
              "type": "range",
              "id": "margin_right",
              "label": "Margin right (text)",
              "min": 0,
              "max": 100,
              "step": 5,
              "unit": "px",
              "default": 0,
              "info": "Additional right margin on the text container"
            },
            {
              "type": "range",
              "id": "margin_top",
              "label": "Margin top (vertical spacing)",
              "min": 0,
              "max": 100,
              "step": 5,
              "unit": "px",
              "default": 0,
              "info": "Extra space from the top position downward"
            },
            {
              "type": "color",
              "id": "text_color",
              "label": "Text color",
              "default": "#FFFFFF"
            },
            {
              "type": "range",
              "id": "text_height",
              "label": "Font size",
              "min": 20,
              "max": 80,
              "step": 2,
              "unit": "px",
              "default": 48
            },
            {
              "type": "range",
              "id": "text_width",
              "label": "Text width",
              "min": 30,
              "max": 100,
              "step": 5,
              "unit": "%",
              "default": 90
            }
          ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Carousel",
      "category": "General",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
